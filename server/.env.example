NODE_ENV=development
PORT=5000

# Neon → your project → branch "dev" → Connect → copy the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full

# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=paste-a-long-random-string-here-at-least-32-characters

# Where people open the site. Dev: the Vite dev server. Production: your Render URL.
APP_URL=http://localhost:5173

# mock = payments confirm instantly. sslcommerz = real sandbox gateway.
PAYMENT_MODE=mock
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
